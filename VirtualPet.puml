@startuml VirtualPet

abstract class Mascota{
    ' -- Atributos
    # nombre: String
    # edad: int 
    # hambre: int
    # felicidad: int
    
    ' -- Constructor
    + Mascota(nombre: String, edad: int)

    ' -- Metodos
    + {abstract} atacarEspecial(): void
    + {abstract} expresarEmocion(): void
    + dormir(): void
    + {abstract} hacerTruco(): void
}

enum TipoElemento {
    AGUA
    FUEGO
    TIERRA
    ELECTRICO
}

class Pokemon{
    ' -- Atributos especiales
    - tipo: TipoElemento

    ' -- Constructor
    + Pokemon(nombre: String, edad: int, tipo: TipoElemento)

    ' -- Metodos
    + atacarEspecial(): void
    + expresarEmocion(): void
    + hacerTruco(): void
}

' -- Asociaciones
Mascota <|-- Pokemon : hereda
Pokemon --> TipoElemento : Elementos

@enduml