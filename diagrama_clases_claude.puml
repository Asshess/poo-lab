@startuml
title Estudio de arquitectura - Diagrama de clases

skinparam classAttributeIconSize 0
skinparam linetype ortho

class JefeProyecto {
  - codigo : int
  - nombre : String
  - direccion : String
  - telefono : String
}

class Proyecto {
  - codigo : int
  - nombre : String
}

class Plano {
  - id : int
  - fechaEntrega : Date
  - arquitectos : List<String>
  - dibujoGeneral : Image
  + calcularNumFiguras() : int
}

abstract class Figura {
  - id : int
  - nombre : String
  - color : String
  - area : double
  - perimetro : double
  + {abstract} calcularArea() : double
  + {abstract} calcularPerimetro() : double
}

class Poligono {
  - numLineas : int
  + calcularArea() : double
  + calcularPerimetro() : double
}

class Linea {
  - id : int
  - longitud : double
  + calcularLongitud() : double
}

class Punto {
  - x : double
  - y : double
}

JefeProyecto "1" -- "0..1" Proyecto : dirige >
Proyecto "0..1" o-- "0..*" Plano : se compone de >
Plano "1" *-- "0..*" Figura : tiene >
Figura <|-- Poligono
Poligono "1" *-- "3..*" Linea : formado por >
Linea "1" *-- "2" Punto : origen y fin >

note right of Linea
  longitud = sqrt((x2 - x1)^2 + (y2 - y1)^2)
end note

@enduml
